# Development (Docker: docker compose up -d)
# Port 5434 avoids conflict with a local PostgreSQL install on 5432
DATABASE_URL="postgresql://darb:darb_secret@localhost:5434/darb?schema=public"

# Production
# DATABASE_URL="postgresql://user:password@host:5432/darb?schema=public&sslmode=require"

JWT_SECRET="change-this-to-a-secure-random-string"
# Optional separate secret for refresh tokens (defaults to JWT_SECRET)
JWT_REFRESH_SECRET=""
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Local QA only — never true in production
OTP_DEV_EXPOSE="false"
PORT=3000
CORS_ORIGIN="*"

# Payment gateway (mock | stripe | tap)
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
TAP_SECRET_KEY=""
